# Copy this file to .env.local (gitignored - never commit real keys) and
# paste your Kimi K3 API key below. Restart `next dev` after editing.
#
# With this set, "Call WattLahMan" skips the in-app key prompt entirely and
# uses this key straight away. This only makes sense for a locally-run dev
# build: NEXT_PUBLIC_ vars are inlined into the client bundle at build time,
# so anyone with access to a deployed build could read it back out.
NEXT_PUBLIC_KIMI_API_KEY=sk-...
